# Database
DATABASE_URL=postgresql://mmxm:changeme@localhost:5432/mmxm
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# MQL5 ingestion
MQL5_API_KEY=change-me-long-random
MQL5_API_SECRET=change-me-long-random-secret
MQL5_TIMESTAMP_SKEW_SECONDS=30
MQL5_NONCE_TTL_SECONDS=60
MQL5_MAX_PAYLOAD_BYTES=1048576

# App
NODE_ENV=development
PORT_API=3001
PORT_WEB=3000
LOG_LEVEL=info

# Trading safety (defaults: signal-only)
TRADING_EXECUTION_ENABLED=false
SIGNAL_ONLY_MODE=true

# Web auth
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_URL=
ALERT_WEBHOOK_URL=

# OTel (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
